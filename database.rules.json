{
  "rules": {
    ".read": false,
    ".write": false,
    "bpt": {
      ".read": "auth != null",
      "state": {
        "main": {
          ".write": "auth != null && newData.exists()",
          ".validate": "newData.hasChild('data') && newData.child('data').hasChildren(['players', 'settings'])"
        }
      },
      "games": {
        ".write": "auth != null",
        "$gameId": {
          ".validate": "newData.hasChildren(['game_key', 'game_data'])"
        }
      },
      "chat": {
        ".write": "auth != null"
      },
      "agenda_v2": {
        ".write": "auth != null"
      },
      "live_v3": {
        "current": {
          ".write": "auth != null"
        },
        "stack_history": {
          "$session": {
            "$player": {
              "records": {
                "$id": {
                  ".write": "auth != null && (data.exists() ? data.child('authorUid').val() === auth.uid : newData.child('authorUid').val() === auth.uid)",
                  ".validate": "newData.hasChildren(['name', 'total', 'at', 'authorUid']) && newData.child('authorUid').val() === auth.uid && newData.child('name').isString() && newData.child('total').isNumber() && newData.child('total').val() >= 0 && newData.child('total').val() <= 100000000 && newData.child('at').isNumber()"
                }
              }
            }
          }
        }
      },
      "config": {
        ".write": "auth != null"
      },
      "photos": {
        ".write": "auth != null"
      },
      "online": {
        ".write": "auth != null"
      },
      "bettingLedger": {
        ".write": "auth != null"
      },
      "app_presence": {
        ".write": "auth != null"
      },
      "connection_history": {
        ".write": "auth != null"
      },
      "backups": {
        "$backupKey": {
          ".write": "auth != null && (!data.exists() || (!newData.exists() && data.child('createdAt').val() < now - 1209600000))",
          ".validate": "newData.hasChildren(['createdAt', 'data']) && newData.child('createdAt').isNumber()"
        }
      },
      "backup_meta": {
        ".write": "auth != null"
      },
      "chip_reference_photos": {
        "$game": {
          "$value": {
            "$id": {
              ".write": "auth != null && ($game === 'moonriver' || $game === 'palace') && $value.matches(/^(25|50|100|500|1000|5000|10000)$/) && $id.matches(/^[A-Za-z0-9_-]{1,40}$/)",
              ".validate": "newData.hasChildren(['data', 'updatedAt'])",
              "data": {
                ".validate": "newData.isString() && newData.val().beginsWith('data:image/jpeg;base64,') && newData.val().length <= 90000"
              },
              "updatedAt": {
                ".validate": "newData.isNumber()"
              },
              "$other": {
                ".validate": false
              }
            }
          }
        }
      }
    },
    "bpt_codes": {
      "$salt": {
        ".write": "auth != null && $salt.matches(/^[0-9a-f]{32}$/)",
        "$digest": {
          ".read": "auth != null",
          ".validate": "$digest.matches(/^[0-9a-f]{64}$/) && newData.val() === true"
        }
      }
    }
  }
}
