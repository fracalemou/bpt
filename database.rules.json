{
  "rules": {
    ".read": false,
    ".write": false,
    "bpt": {
      ".read": "auth != null",
      "state": {
        "main": {
          ".write": "auth != null && newData.exists()",
          ".validate": "newData.hasChild('data') && newData.child('data').hasChildren(['players', 'settings'])"
        }
      },
      "games": {
        ".write": "auth != null",
        "$gameId": {
          ".validate": "newData.hasChildren(['game_key', 'game_data'])"
        }
      },
      "chat": {
        ".write": "auth != null"
      },
      "agenda_v2": {
        ".write": "auth != null"
      },
      "live_v3": {
        ".write": "auth != null"
      },
      "config": {
        ".write": "auth != null"
      },
      "photos": {
        ".write": "auth != null"
      },
      "online": {
        ".write": "auth != null"
      },
      "bettingLedger": {
        ".write": "auth != null"
      },
      "app_presence": {
        ".write": "auth != null"
      },
      "connection_history": {
        ".write": "auth != null"
      },
      "backups": {
        "$backupKey": {
          ".write": "auth != null && (!data.exists() || (!newData.exists() && data.child('createdAt').val() < now - 1209600000))",
          ".validate": "newData.hasChildren(['createdAt', 'data']) && newData.child('createdAt').isNumber()"
        }
      },
      "backup_meta": {
        ".write": "auth != null"
      }
    },
    "bpt_codes": {
      "$salt": {
        ".write": "auth != null && $salt.matches(/^[0-9a-f]{32}$/)",
        "$digest": {
          ".read": "auth != null",
          ".validate": "$digest.matches(/^[0-9a-f]{64}$/) && newData.val() === true"
        }
      }
    }
  }
}
